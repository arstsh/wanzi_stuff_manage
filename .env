# 应用运行环境: development | production
NODE_ENV=development

# 后端监听端口
PORT=3000

# MySQL 连接串（服务器上改成你的真实账号密码和数据库名）
# 格式: mysql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL=mysql://root:ARStsh%@@%1807@1.12.229.230:3306/wanzi_inventory

# JWT 密钥（生产环境必须改成强随机字符串，长度 ≥ 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# 刷新令牌密钥（同样必须强随机，仅服务端持有）
REFRESH_TOKEN_SECRET=change-me-refresh-in-production

# 允许访问后端的域名列表（生产必须显式配置，禁用通配符）
# 多个来源用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# 速率限制：每 IP 15 分钟最大请求数
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
